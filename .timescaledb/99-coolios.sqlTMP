


-- todo: we can assert below using optionsdepth data once we gather 10 days of data.

-- mm_order_imbalance = -1 * order_imbalance

select * from (with c as (
select strike,-1*order_imbalance as mm_oi from candle_expiration
where expiration = '2026-05-12' and contract_type = 'C'
), p as (
select strike,-1*order_imbalance as mm_oi from candle_expiration
where expiration = '2026-05-12' and contract_type = 'P'
)
select strike, -1*p.mm_oi as put_mm_oi, c.mm_oi as call_mm_oi, c.mm_oi + (-1*p.mm_oi) as net_pos from c
left join p using (strike) 
) as foo
where net_pos is not null
order by strike desc


